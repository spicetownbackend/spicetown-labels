<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spicetown.labels</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sundar/spicetown-labels/scripts/run_gunicorn.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sundar/spicetown-labels</string>

    <!-- LaunchDaemon (system domain), not a LaunchAgent: runs regardless of whether
         anyone is logged into the GUI, matching spicetown-backend's pattern on this
         always-on server Mac. Runs as `sundar` (not root) so it has normal ownership
         of the SQLite DB, .env, CUPS access, etc. -->
    <key>UserName</key>
    <string>sundar</string>

    <!-- Start at boot, and restart automatically if it ever crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/sundar/spicetown-labels/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sundar/spicetown-labels/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
        <key>STL_PORT</key>
        <string>8080</string>
    </dict>
</dict>
</plist>
